# Server
PORT=3000
NODE_ENV=development

# Session secret (change to a long random string in production)
SESSION_SECRET=change-me-in-production-use-a-long-random-string

# JWT secret (change to a long random string in production)
JWT_SECRET=change-me-in-production-jwt-secret

# Admin email address (the data owner who approves access)
ADMIN_EMAIL=admin@example.com

# ── PLM adapter selection ─────────────────────────────────────────────────────
# PLM_TYPE controls which PLM backend is used.
#   aras    – Aras Innovator PLM via SOAP/AML (recommended for production)
#   mock    – built-in static data, no server needed (useful for offline dev/demo)
#   generic – generic REST API (RealPlmService)
#
# Set PLM_TYPE=mock to use built-in demo data without a live Aras server.
PLM_TYPE=aras

# ── Aras Innovator settings (PLM_TYPE=aras) ───────────────────────────────────
# Base URL of the Aras Innovator instance (include the database path segment,
# do NOT add a trailing slash).
# Example for the development instance:
#   PLM_BASE_URL=http://localhost/UA-LPT-MYBO-Aras3Shape-development
PLM_BASE_URL=http://localhost/UA-LPT-MYBO-Aras3Shape-development

# Aras database name.  Leave blank to auto-derive from the last path segment
# of PLM_BASE_URL (recommended – keeps config DRY).
# PLM_ARAS_DATABASE=UA-LPT-MYBO-Aras3Shape-development

# Aras login credentials
PLM_USERNAME=admin
PLM_PASSWORD=innovator

# Request timeout in milliseconds
PLM_TIMEOUT_MS=10000

# ── Legacy flag (deprecated – use PLM_TYPE instead) ───────────────────────────
# If set to "true" and PLM_TYPE is not set, uses mock PLM data.
# PLM_USE_MOCK=true

# ── Generic REST API settings (PLM_TYPE=generic) ─────────────────────────────
# PLM_BASE_URL=http://your-plm-server/api
# PLM_API_KEY=your-api-key-here
# PLM_USERNAME=plm_readonly_user
# PLM_PASSWORD=plm_readonly_password

# Database file path
DB_PATH=./data/plm-sharepoint.db

# PostgreSQL connection
DATABASE_URL=postgresql://plm_user:plm_password@localhost:5432/plm_sharepoint
# PDF file storage directory
UPLOAD_DIR=./uploads
