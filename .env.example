# ──────────────────────────────────────────────────────────────────────────────
# PLM SharePoint – environment configuration
# Copy this file to .env and fill in the values for your environment.
# ──────────────────────────────────────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development

# Session secret (change to a long random string in production)
SESSION_SECRET=change-me-in-production-use-a-long-random-string

# JWT secret (change to a long random string in production)
JWT_SECRET=change-me-in-production-jwt-secret

# Admin email address (the data owner who approves access requests)
# The admin account is created/updated automatically on every startup using
# these credentials. Change ADMIN_PASSWORD to your desired password before
# starting the server for the first time.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin1234!

# ── PostgreSQL connection ─────────────────────────────────────────────────────
# Full connection string for your PostgreSQL database.
# The schema and default data are created automatically on first startup.
#
# Docker Compose (default):
DATABASE_URL=postgresql://plm_user:plm_password@localhost:5432/plm_sharepoint
#
# Custom server example:
# DATABASE_URL=postgresql://myuser:mypassword@db.example.com:5432/plm_sharepoint

# ── File storage ──────────────────────────────────────────────────────────────
# Directory where uploaded drawing PDFs are stored.
UPLOAD_DIR=./uploads
