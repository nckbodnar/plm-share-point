# Server
PORT=3000
NODE_ENV=development

# Session secret (change to a long random string in production)
SESSION_SECRET=change-me-in-production-use-a-long-random-string

# JWT secret (change to a long random string in production)
JWT_SECRET=change-me-in-production-jwt-secret

# Admin email address (the data owner who approves access)
ADMIN_EMAIL=admin@example.com

# PLM API configuration
PLM_BASE_URL=http://your-plm-server/api
PLM_API_KEY=your-api-key-here
# Optional: PLM basic auth (if API key is not used)
# PLM_USERNAME=plm_readonly_user
# PLM_PASSWORD=plm_readonly_password
PLM_TIMEOUT_MS=10000

# If set to "true", uses mock PLM data (for development/demo without a real PLM server)
PLM_USE_MOCK=true

# Database file path
DB_PATH=./data/plm-sharepoint.db
