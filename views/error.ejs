<%- include('partials/header', { title, user }) %>

<div class="row justify-content-center">
  <div class="col-md-7">
    <div class="text-center py-5">
      <% if (title === 'Not Found') { %>
        <i class="bi bi-search display-1 text-muted mb-3 d-block"></i>
      <% } else if (title === 'Access Denied') { %>
        <i class="bi bi-lock-fill display-1 text-danger mb-3 d-block"></i>
      <% } else { %>
        <i class="bi bi-exclamation-triangle-fill display-1 text-warning mb-3 d-block"></i>
      <% } %>
      <h1 class="h3 mb-2"><%= title %></h1>
      <p class="text-muted mb-4"><%= message %></p>
      <a href="/" class="btn btn-primary">Go to Home</a>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
