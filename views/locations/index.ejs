<%- include('../partials/header', { title, user }) %>

<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
  <div>
    <h1 class="h3 mb-1"><i class="bi bi-geo-alt me-2 text-primary"></i>Locations</h1>
    <p class="text-muted mb-0 small">Manage storage and filing locations for drawings.</p>
  </div>
  <% if (user && user.isAdmin) { %>
    <a href="/locations/new" class="btn btn-primary btn-sm">
      <i class="bi bi-plus-lg me-1"></i>New Location
    </a>
  <% } %>
</div>

<% if (!locations || locations.length === 0) { %>
  <div class="text-center py-5 text-muted">
    <i class="bi bi-inbox display-3 mb-3 d-block"></i>
    <p class="lead">No locations found.</p>
  </div>
<% } else { %>
  <div class="card shadow-sm">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th>Name</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% locations.forEach(function(location) { %>
              <tr>
                <td>
                  <i class="bi bi-geo-alt-fill me-1 text-secondary"></i>
                  <span class="fw-semibold"><%= location.name %></span>
                </td>
                <td>
                  <% if (user && user.isAdmin) { %>
                    <a href="/locations/<%= location.id %>/edit" class="btn btn-outline-secondary btn-sm">
                      <i class="bi bi-pencil me-1"></i>Edit
                    </a>
                    <form method="POST" action="/locations/<%= location.id %>/delete" class="d-inline">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <button type="submit" class="btn btn-outline-danger btn-sm"
                              onclick="return confirm('Delete location <%= location.name %>?')">
                        <i class="bi bi-trash me-1"></i>Delete
                      </button>
                    </form>
                  <% } else { %>
                    <span class="text-muted small">–</span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <p class="text-muted small mt-3 text-end">
    <i class="bi bi-info-circle me-1"></i>Showing <%= locations.length %> location<%= locations.length !== 1 ? 's' : '' %>.
  </p>
<% } %>

<%- include('../partials/footer') %>
