<%- include('../partials/header', { title, user }) %>

<nav aria-label="breadcrumb" class="mb-3">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/assemblies">Assemblies</a></li>
    <li class="breadcrumb-item active" aria-current="page"><%= assembly.name %></li>
  </ol>
</nav>

<div class="d-flex align-items-start justify-content-between flex-wrap gap-3 mb-4">
  <div>
    <h1 class="h3 mb-1">
      <span class="badge bg-secondary font-monospace me-2">Rev <%= assembly.revision %></span>
      <%= assembly.name %>
    </h1>
    <% if (assembly.description) { %>
      <p class="text-muted mb-2"><%= assembly.description %></p>
    <% } %>
    <span class="badge bg-primary fs-6">
      <i class="bi bi-diagram-3 me-1"></i>Assembly
    </span>
  </div>
  <a href="/assemblies" class="btn btn-outline-secondary btn-sm align-self-start">
    <i class="bi bi-arrow-left me-1"></i>Back to list
  </a>
</div>

<!-- BOM visualisation -->
<div class="card shadow-sm mb-4">
  <div class="card-header d-flex align-items-center gap-2">
    <i class="bi bi-diagram-3 text-primary"></i>
    <strong>Bill of Materials – Interactive Tree</strong>
    <span class="ms-auto text-muted small">Scroll to zoom · Drag to pan</span>
  </div>
  <div class="card-body p-0">
    <div id="bom-flow" style="width:100%;height:480px;"></div>
  </div>
</div>

<!-- Components table -->
<div class="card shadow-sm mb-4">
  <div class="card-header d-flex align-items-center justify-content-between">
    <span><i class="bi bi-table me-2"></i><strong>Components (<%= components.length %>)</strong></span>
    <% if (user && user.isAdmin) { %>
    <button class="btn btn-sm btn-outline-primary" data-bs-toggle="collapse" data-bs-target="#add-component-form">
      <i class="bi bi-plus-lg me-1"></i>Add Component
    </button>
    <% } %>
  </div>

  <% if (user && user.isAdmin) { %>
  <div class="collapse" id="add-component-form">
    <div class="card-body border-bottom">
      <form method="POST" action="/assemblies/<%= assembly.id %>/components" class="row g-2 align-items-end">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <div class="col-md-5">
          <label class="form-label small">Child Part</label>
          <select name="childId" class="form-select form-select-sm" required>
            <option value="">Select part…</option>
            <% allDrawings.forEach(function(d) { %>
              <% if (d.id !== assembly.id) { %>
                <option value="<%= d.id %>"><%= d.name %> (Rev <%= d.revision %>)</option>
              <% } %>
            <% }); %>
          </select>
        </div>
        <div class="col-md-2">
          <label class="form-label small">Quantity</label>
          <input type="number" name="quantity" class="form-control form-control-sm" value="1" min="1" />
        </div>
        <div class="col-md-3">
          <label class="form-label small">Reference Designator</label>
          <input type="text" name="referenceDesignator" class="form-control form-control-sm" placeholder="e.g. R1" />
        </div>
        <div class="col-md-2">
          <button type="submit" class="btn btn-primary btn-sm w-100">Add</button>
        </div>
      </form>
    </div>
  </div>
  <% } %>

  <div class="card-body p-0">
    <% if (components.length === 0) { %>
      <div class="text-center py-4 text-muted">
        <i class="bi bi-inbox me-2"></i>No components yet.
      </div>
    <% } else { %>
    <div class="table-responsive">
      <table class="table table-hover table-sm mb-0">
        <thead class="table-light">
          <tr>
            <th>Ref</th>
            <th>Name</th>
            <th>Revision</th>
            <th>Qty</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% components.forEach(function(c) { %>
          <tr>
            <td class="font-monospace small"><%= c.referenceDesignator || '–' %></td>
            <td><a href="/parts/<%= c.id %>" class="small"><%= c.name %></a></td>
            <td class="small"><%= c.revision %></td>
            <td class="small text-center"><%= c.quantity %></td>
            <td>
              <% if (user && user.isAdmin) { %>
              <form method="POST" action="/assemblies/<%= assembly.id %>/components/<%= c.id %>/delete" class="d-inline">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-1" title="Remove">
                  <i class="bi bi-trash"></i>
                </button>
              </form>
              <% } %>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>
</div>

<div class="mt-4 small text-muted">
  <i class="bi bi-clock me-1"></i>
  Created: <%= new Date(assembly.createdAt).toLocaleString() %>
</div>

<!-- React + ReactFlow via CDN -->
<script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
<script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
<link rel="stylesheet" href="https://unpkg.com/reactflow@11/dist/style.css" />
<script src="https://unpkg.com/reactflow@11/dist/umd/index.js"></script>

<script>
(function () {
  const assemblyId = '<%= assembly.id %>';

  function loadBom() {
    fetch('/assemblies/' + assemblyId + '/bom.json')
      .then(function (r) { return r.json(); })
      .then(function (data) { renderFlow(data.nodes, data.edges); })
      .catch(function (err) {
        console.error('BOM load error', err);
        document.getElementById('bom-flow').innerHTML =
          '<div class="text-center text-muted py-5 p-4">Could not load BOM data.</div>';
      });
  }

  function renderFlow(nodes, edges) {
    const container = document.getElementById('bom-flow');
    const RF = window.ReactFlow;
    if (!RF) {
      container.innerHTML = '<div class="text-center text-muted py-5">ReactFlow could not be loaded.</div>';
      return;
    }
    const ReactFlowComp = RF.ReactFlow;
    const { Background, Controls, MiniMap } = RF;
    const e = React.createElement;

    const styledNodes = nodes.map(function (n) {
      const isRoot = n.data.isRoot;
      return Object.assign({}, n, {
        style: {
          background: isRoot ? '#0d6efd' : '#ffffff',
          color: isRoot ? '#ffffff' : '#212529',
          border: isRoot ? '2px solid #0a58ca' : '2px solid #adb5bd',
          borderRadius: '8px',
          padding: '8px 14px',
          fontSize: '12px',
          minWidth: '160px',
          cursor: isRoot ? 'default' : 'pointer',
          whiteSpace: 'pre-line',
          textAlign: 'center',
        },
      });
    });

    const styledEdges = edges.map(function (ed) {
      return Object.assign({}, ed, {
        style: { stroke: '#6c757d' },
        labelStyle: { fontSize: '11px' },
        type: 'smoothstep',
      });
    });

    function FlowApp() {
      const [nds] = React.useState(styledNodes);
      const [eds] = React.useState(styledEdges);

      function onNodeClick(_evt, node) {
        if (!node.data.isRoot && node.data.partId) {
          window.location.href = '/parts/' + node.data.partId;
        }
      }

      return e('div', { style: { width: '100%', height: '480px' } },
        e(ReactFlowComp, {
          nodes: nds, edges: eds, onNodeClick: onNodeClick,
          fitView: true, attributionPosition: 'bottom-right',
        },
          e(Background, { gap: 20, color: '#dee2e6' }),
          e(Controls),
          e(MiniMap, { zoomable: true, pannable: true }),
        ),
      );
    }

    if (ReactDOM.createRoot) {
      if (container._rfRoot) container._rfRoot.unmount();
      container._rfRoot = ReactDOM.createRoot(container);
      container._rfRoot.render(e(FlowApp));
    } else {
      ReactDOM.render(e(FlowApp), container);
    }
  }

  loadBom();
})();
</script>

<%- include('../partials/footer') %>
