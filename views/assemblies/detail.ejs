<%- include('../partials/header', { title, user }) %>

<nav aria-label="breadcrumb" class="mb-3">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/assemblies">Assemblies</a></li>
    <li class="breadcrumb-item active" aria-current="page"><%= assembly.name %></li>
  </ol>
</nav>

<div class="d-flex align-items-start justify-content-between flex-wrap gap-3 mb-4">
  <div>
    <h1 class="h3 mb-1">
      <span class="badge bg-secondary font-monospace me-2">Rev <%= assembly.revision %></span>
      <%= assembly.name %>
    </h1>
    <% if (assembly.description) { %>
      <p class="text-muted mb-2"><%= assembly.description %></p>
    <% } %>
    <span class="badge bg-primary fs-6">
      <i class="bi bi-diagram-3 me-1"></i>Assembly
    </span>
  </div>
  <a href="/assemblies" class="btn btn-outline-secondary btn-sm align-self-start">
    <i class="bi bi-arrow-left me-1"></i>Back to list
  </a>
</div>

<!-- BOM visualisation -->
<div class="card shadow-sm mb-4">
  <div class="card-header d-flex align-items-center gap-2">
    <i class="bi bi-diagram-3 text-primary"></i>
    <strong>Bill of Materials – Interactive Tree</strong>
    <span class="ms-auto text-muted small">Scroll to zoom · Drag to pan</span>
  </div>
  <div class="card-body p-0">
    <div id="bom-flow" style="width:100%;height:480px;"></div>
  </div>
</div>

<!-- Components table -->
<div class="card shadow-sm mb-4">
  <div class="card-header d-flex align-items-center justify-content-between">
    <span><i class="bi bi-table me-2"></i><strong>Components (<%= components.length %>)</strong></span>
    <% if (user && user.isAdmin) { %>
    <button class="btn btn-sm btn-outline-primary" data-bs-toggle="collapse" data-bs-target="#add-component-form">
      <i class="bi bi-plus-lg me-1"></i>Add Component
    </button>
    <% } %>
  </div>

  <% if (user && user.isAdmin) { %>
  <div class="collapse" id="add-component-form">
    <div class="card-body border-bottom">
      <form method="POST" action="/assemblies/<%= assembly.id %>/components" class="row g-2 align-items-end">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <div class="col-md-4">
          <label class="form-label small">Child Part</label>
          <select name="childId" id="add-childId" class="form-select form-select-sm" required
                  onchange="updateRevisionPicker(this.value)">
            <option value="">Select part…</option>
            <% allDrawings.forEach(function(d) { %>
              <% if (d.id !== assembly.id) { %>
                <option value="<%= d.id %>"
                        data-revisions="<%= JSON.stringify((d.revisions||[]).map(function(r){return{id:r.id,revision:r.revision,notes:r.notes,createdAt:r.createdAt};})) %>">
                  <%= d.name %> (current: Rev <%= d.revision %>)
                </option>
              <% } %>
            <% }); %>
          </select>
        </div>
        <div class="col-md-3">
          <label class="form-label small">Revision to pin <span class="text-muted">(optional)</span></label>
          <select name="pinnedRevisionId" id="add-pinnedRevisionId" class="form-select form-select-sm">
            <option value="">Current revision (latest)</option>
          </select>
        </div>
        <div class="col-md-1">
          <label class="form-label small">Qty</label>
          <input type="number" name="quantity" class="form-control form-control-sm" value="1" min="1" />
        </div>
        <div class="col-md-2">
          <label class="form-label small">Ref. Designator</label>
          <input type="text" name="referenceDesignator" class="form-control form-control-sm" placeholder="e.g. R1" />
        </div>
        <div class="col-md-2">
          <button type="submit" class="btn btn-primary btn-sm w-100">Add</button>
        </div>
      </form>
    </div>
  </div>
  <% } %>

  <div class="card-body p-0">
    <% if (components.length === 0) { %>
      <div class="text-center py-4 text-muted">
        <i class="bi bi-inbox me-2"></i>No components yet.
      </div>
    <% } else { %>
    <div class="table-responsive">
      <table class="table table-hover table-sm mb-0">
        <thead class="table-light">
          <tr>
            <th>Ref</th>
            <th>Name</th>
            <th>Revision</th>
            <th>Qty</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% components.forEach(function(c) { %>
          <tr>
            <td class="font-monospace small"><%= c.referenceDesignator || '–' %></td>
            <td>
              <a href="/parts/<%= c.id %>" class="small fw-semibold"><%= c.name %></a>
            </td>
            <td class="small">
              <% if (c.pinnedRevisionId) { %>
                <%# Pinned to a historical revision %>
                <span class="badge bg-warning text-dark font-monospace me-1" title="Pinned revision">
                  <i class="bi bi-pin-fill me-1"></i>Rev <%= c.pinnedRevision %>
                </span>
                <% if (c.pinnedFilePath) { %>
                  <a href="/parts/<%= c.id %>/revisions/<%= c.pinnedRevisionId %>/download"
                     target="_blank" class="btn btn-outline-secondary btn-sm py-0 px-1 ms-1"
                     title="View PDF for Rev <%= c.pinnedRevision %>">
                    <i class="bi bi-file-earmark-pdf"></i>
                  </a>
                <% } %>
                <span class="text-muted small ms-1">(current: Rev <%= c.revision %>)</span>
              <% } else { %>
                <%# Using current/live revision %>
                <span class="badge bg-secondary font-monospace me-1">Rev <%= c.revision %></span>
                <% if (c.filePath) { %>
                  <a href="/parts/<%= c.id %>/download"
                     target="_blank" class="btn btn-outline-secondary btn-sm py-0 px-1 ms-1"
                     title="View current PDF">
                    <i class="bi bi-file-earmark-pdf"></i>
                  </a>
                <% } %>
              <% } %>
            </td>
            <td class="small text-center"><%= c.quantity %></td>
            <td class="text-end" style="min-width:120px;">
              <% if (user && user.isAdmin) { %>
                <%# Revision pin dropdown %>
                <%
                  var partRevs = [];
                  allDrawings.forEach(function(d) { if (d.id === c.id && d.revisions) partRevs = d.revisions; });
                %>
                <% if (partRevs.length > 0) { %>
                  <button class="btn btn-outline-secondary btn-sm py-0 px-1 me-1"
                          type="button"
                          title="Change pinned revision"
                          data-bs-toggle="collapse"
                          data-bs-target="#pin-form-<%= c.id %>">
                    <i class="bi bi-pin"></i>
                  </button>
                <% } %>
                <form method="POST" action="/assemblies/<%= assembly.id %>/components/<%= c.id %>/delete" class="d-inline">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-1" title="Remove">
                    <i class="bi bi-trash"></i>
                  </button>
                </form>
              <% } %>
            </td>
          </tr>
          <% if (user && user.isAdmin) { %>
            <%
              var partRevs2 = [];
              allDrawings.forEach(function(d) { if (d.id === c.id && d.revisions) partRevs2 = d.revisions; });
            %>
            <% if (partRevs2.length > 0) { %>
            <tr class="collapse" id="pin-form-<%= c.id %>">
              <td colspan="5" class="bg-light py-2 px-3">
                <form method="POST" action="/assemblies/<%= assembly.id %>/components/<%= c.id %>/pin"
                      class="d-flex align-items-center gap-2 flex-wrap">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <label class="form-label mb-0 small fw-semibold">Pin revision:</label>
                  <select name="pinnedRevisionId" class="form-select form-select-sm" style="max-width:320px;">
                    <option value="">Current revision (latest – always up to date)</option>
                    <% partRevs2.forEach(function(r) { %>
                      <option value="<%= r.id %>" <%= c.pinnedRevisionId === r.id ? 'selected' : '' %>>
                        Rev <%= r.revision %>
                        <% if (r.notes) { %> – <%= r.notes %><% } %>
                        (<%= new Date(r.createdAt).toLocaleDateString() %>)
                      </option>
                    <% }); %>
                  </select>
                  <button type="submit" class="btn btn-warning btn-sm">Save</button>
                </form>
              </td>
            </tr>
            <% } %>
          <% } %>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>
</div>

<div class="mt-4 small text-muted">
  <i class="bi bi-clock me-1"></i>
  Created: <%= new Date(assembly.createdAt).toLocaleString() %>
</div>

<% if (user && user.isAdmin) { %>
<div class="card shadow-sm border-warning mt-4">
  <div class="card-header bg-warning bg-opacity-10 d-flex align-items-center gap-2">
    <i class="bi bi-pencil-square text-warning"></i>
    <strong>Edit Assembly</strong>
  </div>
  <div class="card-body">
    <form id="editAssemblyForm">
      <div class="row g-3">
        <div class="col-12 col-md-4">
          <label class="form-label" for="edit-name">Name</label>
          <input type="text" class="form-control form-control-sm" id="edit-name" name="name"
                 value="<%= assembly.name %>" required />
        </div>
        <div class="col-12 col-md-4">
          <label class="form-label" for="edit-revision">Revision</label>
          <input type="text" class="form-control form-control-sm" id="edit-revision" name="revision"
                 value="<%= assembly.revision || '' %>" />
        </div>
        <div class="col-12 col-md-4">
          <label class="form-label" for="edit-description">Description</label>
          <input type="text" class="form-control form-control-sm" id="edit-description" name="description"
                 value="<%= assembly.description || '' %>" />
        </div>
        <div class="col-auto d-flex gap-2">
          <button type="button" class="btn btn-warning btn-sm"
                  data-url="/assemblies/<%= assembly.id %>"
                  data-csrf="<%= csrfToken %>"
                  onclick="submitEdit(this.dataset.url, 'editAssemblyForm', this.dataset.csrf)">
            <i class="bi bi-save me-1"></i>Save Changes
          </button>
          <button type="button" class="btn btn-danger btn-sm"
                  data-url="/assemblies/<%= assembly.id %>"
                  data-csrf="<%= csrfToken %>"
                  onclick="deleteEntity(this.dataset.url, this.dataset.csrf, '/assemblies')">
            <i class="bi bi-trash me-1"></i>Delete Assembly
          </button>
        </div>
      </div>
    </form>
  </div>
</div>
<% } %>

<!-- React + ReactFlow via CDN -->
<script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
<script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
<link rel="stylesheet" href="https://unpkg.com/reactflow@11/dist/style.css" />
<script src="https://unpkg.com/reactflow@11/dist/umd/index.js"></script>

<script>
(function () {
  const assemblyId = '<%= assembly.id %>';

  function loadBom() {
    fetch('/assemblies/' + assemblyId + '/bom.json')
      .then(function (r) { return r.json(); })
      .then(function (data) { renderFlow(data.nodes, data.edges); })
      .catch(function (err) {
        console.error('BOM load error', err);
        document.getElementById('bom-flow').innerHTML =
          '<div class="text-center text-muted py-5 p-4">Could not load BOM data.</div>';
      });
  }

  function renderFlow(nodes, edges) {
    const container = document.getElementById('bom-flow');
    const RF = window.ReactFlow;
    if (!RF) {
      container.innerHTML = '<div class="text-center text-muted py-5">ReactFlow could not be loaded.</div>';
      return;
    }
    const ReactFlowComp = RF.ReactFlow;
    const { Background, Controls, MiniMap } = RF;
    const e = React.createElement;

    const styledNodes = nodes.map(function (n) {
      const isRoot = n.data.isRoot;
      return Object.assign({}, n, {
        style: {
          background: isRoot ? '#0d6efd' : '#ffffff',
          color: isRoot ? '#ffffff' : '#212529',
          border: isRoot ? '2px solid #0a58ca' : '2px solid #adb5bd',
          borderRadius: '8px',
          padding: '8px 14px',
          fontSize: '12px',
          minWidth: '160px',
          cursor: isRoot ? 'default' : 'pointer',
          whiteSpace: 'pre-line',
          textAlign: 'center',
        },
      });
    });

    const styledEdges = edges.map(function (ed) {
      return Object.assign({}, ed, {
        style: { stroke: '#6c757d' },
        labelStyle: { fontSize: '11px' },
        type: 'smoothstep',
      });
    });

    function FlowApp() {
      const [nds] = React.useState(styledNodes);
      const [eds] = React.useState(styledEdges);

      function onNodeClick(_evt, node) {
        if (!node.data.isRoot && node.data.partId) {
          window.location.href = '/parts/' + node.data.partId;
        }
      }

      return e('div', { style: { width: '100%', height: '480px' } },
        e(ReactFlowComp, {
          nodes: nds, edges: eds, onNodeClick: onNodeClick,
          fitView: true, attributionPosition: 'bottom-right',
        },
          e(Background, { gap: 20, color: '#dee2e6' }),
          e(Controls),
          e(MiniMap, { zoomable: true, pannable: true }),
        ),
      );
    }

    if (ReactDOM.createRoot) {
      if (container._rfRoot) container._rfRoot.unmount();
      container._rfRoot = ReactDOM.createRoot(container);
      container._rfRoot.render(e(FlowApp));
    } else {
      ReactDOM.render(e(FlowApp), container);
    }
  }

  loadBom();
})();
</script>

<script>
// Populate the revision picker in the Add Component form when a part is selected
function updateRevisionPicker(partId) {
  var sel = document.getElementById('add-pinnedRevisionId');
  sel.innerHTML = '<option value="">Current revision (latest)</option>';
  if (!partId) return;
  var partOpt = document.querySelector('#add-childId option[value="' + partId + '"]');
  if (!partOpt) return;
  var revisions = JSON.parse(partOpt.dataset.revisions || '[]');
  revisions.forEach(function(r) {
    var opt = document.createElement('option');
    opt.value = r.id;
    opt.textContent = 'Rev ' + r.revision +
      (r.notes ? ' \u2013 ' + r.notes : '') +
      ' (' + new Date(r.createdAt).toLocaleDateString() + ')';
    sel.appendChild(opt);
  });
}
</script>

<%- include('../partials/footer') %>
