<%- include('../partials/header', { title, user }) %>

<nav aria-label="breadcrumb" class="mb-3">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/assemblies">Assemblies</a></li>
    <li class="breadcrumb-item active" aria-current="page">New Assembly</li>
  </ol>
</nav>

<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="card shadow-sm">
      <div class="card-header">
        <h5 class="mb-0"><i class="bi bi-diagram-3 me-2"></i>Create New Assembly</h5>
      </div>
      <div class="card-body">
        <% if (error) { %>
          <div class="alert alert-danger"><%= error %></div>
        <% } %>
        <form method="POST" action="/assemblies">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <div class="mb-3">
            <label class="form-label">Name <span class="text-danger">*</span></label>
            <input type="text" name="name" class="form-control" required placeholder="Assembly name" />
          </div>
          <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea name="description" class="form-control" rows="3" placeholder="Optional description"></textarea>
          </div>
          <div class="mb-3">
            <label class="form-label">Revision</label>
            <input type="text" name="revision" class="form-control" value="A" placeholder="e.g. A, B, v1.0" />
          </div>
          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Create Assembly</button>
            <a href="/assemblies" class="btn btn-outline-secondary">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
