<%- include('../partials/header', { title, user }) %>

<div class="d-flex align-items-center justify-content-between mb-4">
  <div>
    <h1 class="h3 mb-1"><i class="bi bi-people me-2 text-primary"></i>Manage Users</h1>
    <p class="text-muted mb-0 small">Assign groups and locations to users.</p>
  </div>
</div>

<div class="table-responsive">
  <table class="table table-hover">
    <thead class="table-light">
      <tr>
        <th>User</th>
        <th>Email</th>
        <th>Company</th>
        <th>Group</th>
        <th>Location</th>
        <th>Status</th>
        <th width="120">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% users.forEach(function(u) { %>
        <tr>
          <td>
            <div class="d-flex align-items-center">
              <div class="avatar-circle me-2">
                <%= u.name.charAt(0).toUpperCase() %>
              </div>
              <div>
                <div class="fw-medium"><%= u.name %></div>
                <% if (u.reason) { %>
                  <small class="text-muted"><%= u.reason %></small>
                <% } %>
              </div>
            </div>
          </td>
          <td><%= u.email %></td>
          <td><%= u.company || '-' %></td>
          <td>
            <% if (u.groupName) { %>
              <span class="badge bg-primary"><%= u.groupName %></span>
            <% } else { %>
              <span class="text-muted">-</span>
            <% } %>
          </td>
          <td>
            <% if (u.locationName) { %>
              <span class="badge bg-success"><%= u.locationName %></span>
            <% } else { %>
              <span class="text-muted">-</span>
            <% } %>
          </td>
          <td>
            <% if (u.isApproved) { %>
              <span class="badge bg-success">Approved</span>
            <% } else { %>
              <span class="badge bg-warning">Pending</span>
            <% } %>
          </td>
          <td>
            <% if (u.isApproved) { %>
              <button type="button" class="btn btn-sm btn-outline-primary" 
                      data-bs-toggle="modal" 
                      data-bs-target="#assignModal<%= u.id %>">
                <i class="bi bi-gear"></i>
              </button>
            <% } %>
          </td>
        </tr>

        <!-- Assignment Modal -->
        <div class="modal fade" id="assignModal<%= u.id %>" tabindex="-1" aria-labelledby="assignModalLabel<%= u.id %>" aria-hidden="true">
          <div class="modal-dialog">
            <div class="modal-content">
              <div class="modal-header">
                <h5 class="modal-title" id="assignModalLabel<%= u.id %>">Assign Group & Location</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
              </div>
              <form method="POST" action="/admin/users/<%= u.id %>/assign">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <div class="modal-body">
                  <div class="mb-3">
                    <label for="groupId<%= u.id %>" class="form-label">Group</label>
                    <select class="form-select" id="groupId<%= u.id %>" name="groupId">
                      <option value="">No Group</option>
                      <% groups.forEach(function(group) { %>
                        <option value="<%= group.id %>" <%= u.groupId === group.id ? 'selected' : '' %>>
                          <%= group.name %> (<%= group.type %>)
                        </option>
                      <% }); %>
                    </select>
                  </div>
                  <div class="mb-3">
                    <label for="locationId<%= u.id %>" class="form-label">Location</label>
                    <select class="form-select" id="locationId<%= u.id %>" name="locationId">
                      <option value="">No Location</option>
                      <% locations.forEach(function(location) { %>
                        <option value="<%= location.id %>" <%= u.locationId === location.id ? 'selected' : '' %>>
                          <%= location.name %> (<%= location.type %>)
                        </option>
                      <% }); %>
                    </select>
                  </div>
                </div>
                <div class="modal-footer">
                  <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                  <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
              </form>
            </div>
          </div>
        </div>
      <% }); %>
    </tbody>
  </table>
</div>

<% if (users.length === 0) { %>
  <div class="text-center py-5">
    <i class="bi bi-people display-1 text-muted"></i>
    <h3 class="text-muted mt-3">No Users</h3>
    <p class="text-muted">No non-admin users found.</p>
  </div>
<% } %>

<style>
.avatar-circle {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background-color: #6c757d;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
  font-size: 14px;
}
</style>

<%- include('../partials/footer') %>