<%- include('partials/header', { title, user }) %>

<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="card shadow-sm">
      <div class="card-body p-4">
        <div class="text-center mb-4">
          <i class="bi bi-person-plus-fill text-primary display-5"></i>
          <h2 class="h4 mt-2">Request Access</h2>
          <p class="text-muted small">
            Submit your details below. A data owner will review your request and grant
            access if approved.
          </p>
        </div>

        <% if (success) { %>
          <div class="alert alert-success d-flex align-items-start gap-2" role="alert">
            <i class="bi bi-check-circle-fill mt-1 flex-shrink-0"></i>
            <div>
              <strong>Request submitted!</strong><br />
              Your access request has been received. You will be notified once it has been
              reviewed by the data owner. Please check your email.
            </div>
          </div>
          <div class="text-center mt-3">
            <a href="/login" class="btn btn-outline-primary">Back to Sign In</a>
          </div>
        <% } else { %>

          <% if (error) { %>
            <div class="alert alert-danger d-flex align-items-start gap-2" role="alert">
              <i class="bi bi-exclamation-triangle-fill mt-1 flex-shrink-0"></i>
              <span><%= error %></span>
            </div>
          <% } %>

          <form method="POST" action="/request-access" novalidate>

            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

            <div class="mb-3">
              <label for="name" class="form-label">Full name <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="name" name="name"
                     value="<%= (typeof prefill !== 'undefined' && prefill.name) ? prefill.name : '' %>"
                     autocomplete="name" required />
            </div>

            <div class="mb-3">
              <label for="email" class="form-label">Work email address <span class="text-danger">*</span></label>
              <input type="email" class="form-control" id="email" name="email"
                     value="<%= (typeof prefill !== 'undefined' && prefill.email) ? prefill.email : '' %>"
                     autocomplete="email" required />
            </div>

            <div class="mb-3">
              <label for="company" class="form-label">Company / department</label>
              <input type="text" class="form-control" id="company" name="company"
                     value="<%= (typeof prefill !== 'undefined' && prefill.company) ? prefill.company : '' %>"
                     autocomplete="organization" />
            </div>

            <div class="mb-3">
              <label for="reason" class="form-label">Reason for access <span class="text-danger">*</span></label>
              <textarea class="form-control" id="reason" name="reason" rows="3"
                        placeholder="Briefly describe why you need access to the released part specifications…"
                        required><%= (typeof prefill !== 'undefined' && prefill.reason) ? prefill.reason : '' %></textarea>
            </div>

            <div class="mb-3">
              <label for="password" class="form-label">Choose a password <span class="text-danger">*</span></label>
              <input type="password" class="form-control" id="password" name="password"
                     autocomplete="new-password" minlength="8" required />
              <div class="form-text">At least 8 characters.</div>
            </div>

            <div class="mb-4">
              <label for="passwordConfirm" class="form-label">Confirm password <span class="text-danger">*</span></label>
              <input type="password" class="form-control" id="passwordConfirm" name="passwordConfirm"
                     autocomplete="new-password" required />
            </div>

            <div class="d-grid">
              <button type="submit" class="btn btn-primary">Submit Request</button>
            </div>

          </form>

          <hr />
          <p class="text-center text-muted small mb-0">
            Already have access? <a href="/login">Sign in</a>
          </p>

        <% } %>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
