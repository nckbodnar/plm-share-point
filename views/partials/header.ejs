<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | PLM SharePoint</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="d-flex min-vh-100">

<% if (typeof user !== 'undefined' && user) { %>
<!-- Sidebar -->
<nav class="sidebar bg-primary text-white position-fixed h-100" style="width: 250px;">
  <div class="sidebar-header p-3 border-bottom border-primary-subtle">
    <a class="navbar-brand d-flex align-items-center gap-2 text-white text-decoration-none" href="/">
      <i class="bi bi-gear-wide-connected fs-4"></i>
      <span class="fw-semibold">PLM SharePoint</span>
    </a>
  </div>
  
  <div class="sidebar-body p-3">
    <ul class="nav nav-pills flex-column">
      <li class="nav-item mb-2">
        <a class="nav-link text-white" href="/parts">
          <i class="bi bi-box-seam me-2"></i>Released Parts
        </a>
      </li>
      <li class="nav-item mb-2">
        <a class="nav-link text-white" href="/assemblies">
          <i class="bi bi-diagram-3 me-2"></i>Assemblies
        </a>
      </li>
      <li class="nav-item mb-2">
        <a class="nav-link text-white" href="/drawings">
          <i class="bi bi-file-earmark-ruled me-2"></i>Drawings
        </a>
      </li>
      <li class="nav-item mb-2">
        <a class="nav-link text-white" href="/projects">
          <i class="bi bi-folder me-2"></i>Projects
        </a>
      </li>
      <li class="nav-item mb-2">
        <a class="nav-link text-white" href="/locations">
          <i class="bi bi-geo-alt me-2"></i>Locations
        </a>
      </li>
      <li class="nav-item mb-2">
        <a class="nav-link text-white" href="/groups">
          <i class="bi bi-people me-2"></i>Groups
        </a>
      </li>
      <% if (user.isAdmin) { %>
      <li class="nav-item mb-2">
        <a class="nav-link text-white" href="/admin/dashboard">
          <i class="bi bi-shield-lock me-2"></i>Access Management
        </a>
      </li>
      <li class="nav-item mb-2">
        <a class="nav-link text-white" href="/admin/users">
          <i class="bi bi-person-gear me-2"></i>Manage Users
        </a>
      </li>
      <li class="nav-item mb-2">
        <a class="nav-link text-white" href="/admin/audit">
          <i class="bi bi-journal-text me-2"></i>Audit Log
        </a>
      </li>
      <li class="nav-item mb-2">
        <a class="nav-link text-white" href="/admin/profile">
          <i class="bi bi-key me-2"></i>Change Password
        </a>
      </li>
      <% } %>
    </ul>
  </div>
  
  <div class="sidebar-footer p-3 border-top border-primary-subtle mt-auto">
    <div class="d-flex align-items-center gap-2 text-white-50 mb-2">
      <i class="bi bi-person-circle"></i>
      <small><%= user.email %></small>
    </div>
    <a class="btn btn-outline-light btn-sm w-100" href="/logout">
      <i class="bi bi-box-arrow-right me-1"></i>Sign Out
    </a>
  </div>
</nav>

<!-- Main content -->
<div class="main-content w-100" style="margin-left: 250px;">
  <div class="container-fluid py-4">
<% } else { %>
<!-- Top navbar for non-authenticated users -->
<% if (title !== 'Login') { %>
<nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
  <div class="container-fluid">
    <a class="navbar-brand d-flex align-items-center gap-2" href="/">
      <i class="bi bi-gear-wide-connected fs-5"></i>
      <span class="fw-semibold">PLM SharePoint</span>
    </a>
    <ul class="navbar-nav ms-auto">
      <li class="nav-item"><a class="nav-link" href="/login">Sign In</a></li>
      <li class="nav-item"><a class="nav-link btn btn-outline-light btn-sm px-3 ms-2" href="/request-access">Request Access</a></li>
    </ul>
  </div>
</nav>

<main class="container py-4 flex-grow-1">
<% } else { %>
<main class="flex-grow-1">
<% } %>
<% } %>
