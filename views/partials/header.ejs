<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | PLM SharePoint</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="d-flex flex-column min-vh-100">

<nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
  <div class="container-fluid">
    <a class="navbar-brand d-flex align-items-center gap-2" href="/">
      <i class="bi bi-gear-wide-connected fs-5"></i>
      <span class="fw-semibold">PLM SharePoint</span>
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain" aria-controls="navMain" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navMain">
      <% if (typeof user !== 'undefined' && user) { %>
        <ul class="navbar-nav me-auto">
          <li class="nav-item">
            <a class="nav-link" href="/parts"><i class="bi bi-box-seam me-1"></i>Released Parts</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/assemblies"><i class="bi bi-diagram-3 me-1"></i>Assemblies</a>
          </li>
          <% if (user.isAdmin) { %>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown" aria-expanded="false">
              <i class="bi bi-shield-check me-1"></i>Admin
            </a>
            <ul class="dropdown-menu">
              <li><a class="dropdown-item" href="/admin/dashboard"><i class="bi bi-people me-2"></i>Access Management</a></li>
              <li><a class="dropdown-item" href="/admin/audit"><i class="bi bi-journal-text me-2"></i>Audit Log</a></li>
            </ul>
          </li>
          <% } %>
        </ul>
        <ul class="navbar-nav ms-auto align-items-center">
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle d-flex align-items-center gap-1" href="#" data-bs-toggle="dropdown" aria-expanded="false">
              <i class="bi bi-person-circle"></i>
              <span class="d-none d-md-inline"><%= user.email %></span>
            </a>
            <ul class="dropdown-menu dropdown-menu-end">
              <% if (user.isAdmin) { %>
              <li><a class="dropdown-item" href="/admin/profile"><i class="bi bi-key me-2"></i>Change Password</a></li>
              <li><hr class="dropdown-divider"></li>
              <% } %>
              <li><a class="dropdown-item" href="/logout"><i class="bi bi-box-arrow-right me-2"></i>Sign Out</a></li>
            </ul>
          </li>
        </ul>
      <% } else { %>
        <ul class="navbar-nav ms-auto">
          <li class="nav-item"><a class="nav-link" href="/login">Sign In</a></li>
          <li class="nav-item"><a class="nav-link btn btn-outline-light btn-sm px-3 ms-2" href="/request-access">Request Access</a></li>
        </ul>
      <% } %>
    </div>
  </div>
</nav>

<main class="container py-4 flex-grow-1">
