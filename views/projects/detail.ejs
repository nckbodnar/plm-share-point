<%- include('../partials/header', { title, user }) %>

<nav aria-label="breadcrumb" class="mb-3">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/projects">Projects</a></li>
    <li class="breadcrumb-item active" aria-current="page"><%= project.name %></li>
  </ol>
</nav>

<div class="d-flex align-items-start justify-content-between flex-wrap gap-3 mb-4">
  <div>
    <h1 class="h3 mb-1"><i class="bi bi-folder2-open me-2 text-primary"></i><%= project.name %></h1>
    <% if (project.description) { %>
      <p class="text-muted mb-0"><%= project.description %></p>
    <% } %>
    <div class="mt-2">
      <span class="badge bg-<%= project.status === 'Active' ? 'success' : project.status === 'In Progress' ? 'warning' : 'secondary' %>">
        <%= project.status %>
      </span>
      <% if (project.manager) { %>
        <span class="ms-2 text-muted small">Manager: <%= project.manager %></span>
      <% } %>
    </div>
  </div>
  <a href="/projects" class="btn btn-outline-secondary btn-sm align-self-start">
    <i class="bi bi-arrow-left me-1"></i>Back to list
  </a>
</div>

<div class="row g-4">
  
  <!-- Project Details -->
  <div class="col-12 col-lg-6">
    <div class="card shadow-sm">
      <div class="card-header d-flex align-items-center gap-2">
        <i class="bi bi-info-circle text-primary"></i>
        <strong>Project Details</strong>
      </div>
      <div class="card-body">
        <table class="table table-borderless table-sm">
          <tr>
            <td><strong>Status:</strong></td>
            <td><%= project.status %></td>
          </tr>
          <tr>
            <td><strong>Manager:</strong></td>
            <td><%= project.manager || '-' %></td>
          </tr>
          <tr>
            <td><strong>Start Date:</strong></td>
            <td><%= project.startDate || '-' %></td>
          </tr>
          <tr>
            <td><strong>End Date:</strong></td>
            <td><%= project.endDate || '-' %></td>
          </tr>
          <tr>
            <td><strong>Created:</strong></td>
            <td><%= new Date(project.createdAt).toLocaleDateString() %></td>
          </tr>
        </table>
      </div>
    </div>
  </div>

  <!-- Access Permissions -->
  <div class="col-12 col-lg-6">
    <div class="card shadow-sm">
      <div class="card-header d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-2">
          <i class="bi bi-shield-lock text-primary"></i>
          <strong>Access Permissions</strong>
        </div>
        <% if (user && user.isAdmin) { %>
          <button type="button" class="btn btn-sm btn-outline-primary" 
                  data-bs-toggle="modal" 
                  data-bs-target="#addPermissionModal">
            <i class="bi bi-plus"></i>
          </button>
        <% } %>
      </div>
      <div class="card-body">
        <% if (!permissions || permissions.length === 0) { %>
          <p class="text-muted small mb-0">No permissions assigned. Only admins can access this project.</p>
        <% } else { %>
          <div class="row g-2">
            <% permissions.forEach(function(perm) { %>
              <div class="col-12">
                <div class="d-flex align-items-center justify-content-between border rounded p-2">
                  <div class="d-flex align-items-center">
                    <% if (perm.groupId) { %>
                      <% const group = groups.find(g => g.id === perm.groupId); %>
                      <i class="bi bi-people me-2 text-primary"></i>
                      <span><%= group ? group.name : 'Unknown Group' %></span>
                      <span class="badge bg-primary ms-2"><%= group ? group.type : '' %></span>
                    <% } else if (perm.locationId) { %>
                      <% const location = locations.find(l => l.id === perm.locationId); %>
                      <i class="bi bi-geo-alt me-2 text-success"></i>
                      <span><%= location ? location.name : 'Unknown Location' %></span>
                      <span class="badge bg-success ms-2"><%= location ? location.type : '' %></span>
                    <% } %>
                  </div>
                  <% if (user && user.isAdmin) { %>
                    <button type="button" class="btn btn-sm btn-outline-danger" 
                            onclick="removePermission(<%= project.id %>, <%= perm.id %>)">
                      <i class="bi bi-x"></i>
                    </button>
                  <% } %>
                </div>
              </div>
            <% }); %>
          </div>
        <% } %>
      </div>
    </div>
  </div>

</div>

<!-- Add Permission Modal -->
<% if (user && user.isAdmin) { %>
<div class="modal fade" id="addPermissionModal" tabindex="-1" aria-labelledby="addPermissionModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="addPermissionModalLabel">Add Access Permission</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form method="POST" action="/projects/<%= project.id %>/permissions">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <div class="modal-body">
          <p class="text-muted small mb-3">Grant access to a group or location. Users belonging to the selected group or location will be able to view this project's drawings.</p>
          
          <div class="mb-3">
            <label for="permissionType" class="form-label">Permission Type</label>
            <select class="form-select" id="permissionType" name="permissionType" onchange="togglePermissionFields()">
              <option value="group">Group</option>
              <option value="location">Location</option>
            </select>
          </div>

          <div id="groupSection">
            <label for="groupId" class="form-label">Group</label>
            <select class="form-select" id="groupId" name="groupId">
              <option value="">Select a group...</option>
              <% groups.forEach(function(group) { %>
                <option value="<%= group.id %>"><%= group.name %> (<%= group.type %>)</option>
              <% }); %>
            </select>
          </div>

          <div id="locationSection" style="display: none;">
            <label for="locationId" class="form-label">Location</label>
            <select class="form-select" id="locationId" name="locationId">
              <option value="">Select a location...</option>
              <% locations.forEach(function(location) { %>
                <option value="<%= location.id %>"><%= location.name %> (<%= location.type %>)</option>
              <% }); %>
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Add Permission</button>
        </div>
      </form>
    </div>
  </div>
</div>
<% } %>

<script>
function togglePermissionFields() {
  const type = document.getElementById('permissionType').value;
  const groupSection = document.getElementById('groupSection');
  const locationSection = document.getElementById('locationSection');
  
  if (type === 'group') {
    groupSection.style.display = 'block';
    locationSection.style.display = 'none';
    document.getElementById('groupId').required = true;
    document.getElementById('locationId').required = false;
    document.getElementById('locationId').value = '';
  } else {
    groupSection.style.display = 'none';
    locationSection.style.display = 'block';
    document.getElementById('groupId').required = false;
    document.getElementById('locationId').required = true;
    document.getElementById('groupId').value = '';
  }
}

function removePermission(projectId, permissionId) {
  if (confirm('Are you sure you want to remove this permission?')) {
    fetch(`/projects/${projectId}/permissions/${permissionId}`, {
      method: 'DELETE',
      headers: {
        'Content-Type': 'application/json',
        'X-Requested-With': 'XMLHttpRequest'
      }
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        location.reload();
      } else {
        alert('Error removing permission');
      }
    })
    .catch(error => {
      console.error('Error:', error);
      alert('Error removing permission');
    });
  }
}
</script>

<%- include('../partials/footer') %>