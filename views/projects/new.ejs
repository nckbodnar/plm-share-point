<%- include('../partials/header', { title, user }) %>

<nav aria-label="breadcrumb" class="mb-3">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/projects">Projects</a></li>
    <li class="breadcrumb-item active">New Project</li>
  </ol>
</nav>

<div class="mb-4">
  <h1 class="h3 mb-1"><i class="bi bi-plus-circle me-2 text-primary"></i>New Project</h1>
</div>

<% if (error) { %>
  <div class="alert alert-danger"><%= error %></div>
<% } %>

<div class="card shadow-sm" style="max-width:500px;">
  <div class="card-body">
    <form method="POST" action="/projects">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <div class="mb-3">
        <label class="form-label fw-semibold" for="name">Name <span class="text-danger">*</span></label>
        <input type="text" class="form-control" id="name" name="name" required autofocus />
      </div>
      <div class="mb-3">
        <label class="form-label fw-semibold" for="description">Description</label>
        <textarea class="form-control" id="description" name="description" rows="3"></textarea>
      </div>
      <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary btn-sm">
          <i class="bi bi-check-lg me-1"></i>Create Project
        </button>
        <a href="/projects" class="btn btn-outline-secondary btn-sm">Cancel</a>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
