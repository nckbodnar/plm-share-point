<%- include('../partials/header', { title, user }) %>

<nav aria-label="breadcrumb" class="mb-3">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/parts">Parts</a></li>
    <li class="breadcrumb-item active" aria-current="page"><%= drawing.name %></li>
  </ol>
</nav>

<div class="d-flex align-items-start justify-content-between flex-wrap gap-3 mb-4">
  <div>
    <h1 class="h3 mb-1">
      <%= drawing.name %>
      <% if (drawing.revision) { %>
        <span class="badge bg-secondary font-monospace ms-2 fs-6"><%= drawing.revision %></span>
      <% } %>
    </h1>
    <% if (drawing.description) { %>
      <p class="text-muted mb-0"><%= drawing.description %></p>
    <% } %>
  </div>
  <a href="/parts" class="btn btn-outline-secondary btn-sm align-self-start">
    <i class="bi bi-arrow-left me-1"></i>Back to list
  </a>
</div>

<div class="row g-3 mx-n3 mx-lg-n4">

  <!-- PDF Viewer "” main column (left, 8/12) -->
  <div class="col-12 col-lg-8">
    <div class="card shadow-sm">
      <div class="card-header d-flex align-items-center justify-content-between gap-2">
        <span class="d-flex align-items-center gap-2">
          <i class="bi bi-file-earmark-pdf text-danger"></i>
          <strong>Part PDF</strong>
        </span>
        <% if (drawing.filePath) { %>
          <a href="/parts/<%= drawing.id %>/download" class="btn btn-outline-primary btn-sm" download>
            <i class="bi bi-download me-1"></i>Download
          </a>
        <% } %>
      </div>
      <div class="card-body p-0">
        <% if (drawing.filePath) { %>
          <iframe src="/parts/<%= drawing.id %>/download"
                  style="width:100%; height:90vh; min-height:600px; border:none; display:block;"
                  title="Part PDF: <%= drawing.name %>"></iframe>
        <% } else { %>
          <div class="d-flex flex-column align-items-center justify-content-center text-muted py-5" style="min-height:300px;">
            <i class="bi bi-file-earmark-x display-4 mb-3"></i>
            <p class="mb-0">No PDF attached.</p>
          </div>
        <% } %>
        <% if (user && user.isAdmin) { %>
          <div class="p-3 border-top bg-light">
            <div class="text-muted small mb-2 fw-semibold">Upload PDF</div>
            <form method="POST" action="/parts/<%= drawing.id %>/upload?_csrf=<%= encodeURIComponent(csrfToken) %>" enctype="multipart/form-data" class="d-flex gap-2 align-items-center flex-wrap">
              <input type="file" class="form-control form-control-sm" name="pdf" accept="application/pdf" required />
              <button type="submit" class="btn btn-primary btn-sm text-nowrap">
                <i class="bi bi-upload me-1"></i>Upload
              </button>
            </form>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Sidebar "” right column (4/12) -->
  <div class="col-12 col-lg-4 d-flex flex-column gap-3">

    <!-- Metadata -->
    <div class="card shadow-sm">
      <div class="card-header d-flex align-items-center gap-2">
        <i class="bi bi-tag text-primary"></i>
        <strong>Metadata</strong>
      </div>
      <div class="card-body">
        <% if (drawing.metadata && Object.keys(drawing.metadata).length) { %>
          <% if (drawing.metadata.author) { %>
            <div class="mb-2">
              <div class="text-muted small">Author</div>
              <div class="fw-semibold"><%= drawing.metadata.author %></div>
            </div>
          <% } %>
          <% if (drawing.metadata.version) { %>
            <div class="mb-2">
              <div class="text-muted small">Version</div>
              <div class="fw-semibold"><%= drawing.metadata.version %></div>
            </div>
          <% } %>
          <% if (drawing.metadata.tags && drawing.metadata.tags.length) { %>
            <div class="mb-2">
              <div class="text-muted small mb-1">Tags</div>
              <% drawing.metadata.tags.forEach(function(tag) { %>
                <span class="badge bg-info text-dark me-1 mb-1"><%= tag %></span>
              <% }); %>
            </div>
          <% } %>
          <%
            const reserved = ['author', 'version', 'tags'];
            const customKeys = Object.keys(drawing.metadata).filter(function(k) { return reserved.indexOf(k) === -1; });
          %>
          <% customKeys.forEach(function(key) { %>
            <div class="mb-2">
              <div class="text-muted small"><%= key %></div>
              <div class="fw-semibold"><%= JSON.stringify(drawing.metadata[key]) %></div>
            </div>
          <% }); %>
        <% } else { %>
          <p class="text-muted small mb-0">No metadata.</p>
        <% } %>
      </div>
    </div>

    <!-- Assigned Projects -->
    <div class="card shadow-sm">
      <div class="card-header d-flex align-items-center gap-2">
        <i class="bi bi-folder text-primary"></i>
        <strong>Assigned Projects</strong>
      </div>
      <div class="card-body">
        <% if (drawing.projects && drawing.projects.length) { %>
          <div class="d-flex flex-wrap gap-2 mb-3">
            <% drawing.projects.forEach(function(p) { %>
              <span class="badge bg-primary d-inline-flex align-items-center gap-1 fs-6 fw-normal px-2 py-1">
                <i class="bi bi-folder2-open"></i>
                <a href="/projects/<%= p.id %>" class="text-white text-decoration-none"><%= p.name %></a>
                <% if (user && user.isAdmin) { %>
                  <button type="button" class="btn-close btn-close-white ms-1" style="font-size:0.55rem;"
                          data-url="/parts/<%= drawing.id %>/projects/<%= p.id %>"
                          data-csrf="<%= csrfToken %>"
                          onclick="removeAssignment(this.dataset.url, this.dataset.csrf, ()=>location.reload())"
                          title="Remove" aria-label="Remove"></button>
                <% } %>
              </span>
            <% }); %>
          </div>
        <% } else { %>
          <p class="text-muted small mb-3">No projects assigned yet.</p>
        <% } %>
        <% if (user && user.isAdmin) { %>
          <form method="POST" action="/parts/<%= drawing.id %>/projects" class="d-flex gap-2 align-items-center">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <select class="form-select form-select-sm" name="projectId" required>
              <option value="" disabled selected>Select project to add…</option>
              <% if (allProjects) { allProjects.forEach(function(p) { %>
                <% const already = drawing.projects && drawing.projects.some(function(x){ return x.id === p.id; }); %>
                <% if (!already) { %>
                  <option value="<%= p.id %>"><%= p.name %></option>
                <% } %>
              <% }); } %>
            </select>
            <button type="submit" class="btn btn-primary btn-sm text-nowrap">
              <i class="bi bi-plus-lg"></i> Add
            </button>
          </form>
        <% } %>
      </div>
    </div>

    <!-- Assigned Locations -->
    <div class="card shadow-sm">
      <div class="card-header d-flex align-items-center gap-2">
        <i class="bi bi-geo-alt text-primary"></i>
        <strong>Assigned Locations</strong>
      </div>
      <div class="card-body">
        <% if (drawing.locations && drawing.locations.length) { %>
          <div class="d-flex flex-wrap gap-2 mb-3">
            <% drawing.locations.forEach(function(l) { %>
              <span class="badge bg-success d-inline-flex align-items-center gap-1 fs-6 fw-normal px-2 py-1">
                <i class="bi bi-geo-alt-fill"></i>
                <%= l.name %>
                <% if (user && user.isAdmin) { %>
                  <button type="button" class="btn-close btn-close-white ms-1" style="font-size:0.55rem;"
                          data-url="/parts/<%= drawing.id %>/locations/<%= l.id %>"
                          data-csrf="<%= csrfToken %>"
                          onclick="removeAssignment(this.dataset.url, this.dataset.csrf, ()=>location.reload())"
                          title="Remove" aria-label="Remove"></button>
                <% } %>
              </span>
            <% }); %>
          </div>
        <% } else { %>
          <p class="text-muted small mb-3">No locations assigned yet.</p>
        <% } %>
        <% if (user && user.isAdmin) { %>
          <form method="POST" action="/parts/<%= drawing.id %>/locations" class="d-flex gap-2 align-items-center">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <select class="form-select form-select-sm" name="locationId" required>
              <option value="" disabled selected>Select location to add…</option>
              <% if (allLocations) { allLocations.forEach(function(l) { %>
                <% const already = drawing.locations && drawing.locations.some(function(x){ return x.id === l.id; }); %>
                <% if (!already) { %>
                  <option value="<%= l.id %>"><%= l.name %></option>
                <% } %>
              <% }); } %>
            </select>
            <button type="submit" class="btn btn-success btn-sm text-nowrap">
              <i class="bi bi-plus-lg"></i> Add
            </button>
          </form>
        <% } %>
      </div>
    </div>

    <!-- Revision History -->
    <div class="card shadow-sm">
      <div class="card-header d-flex align-items-center gap-2">
        <i class="bi bi-clock-history text-secondary"></i>
        <strong>Revision History</strong>
        <% if (revisions && revisions.length) { %>
          <span class="badge bg-secondary ms-auto"><%= revisions.length %></span>
        <% } %>
      </div>
      <div class="card-body p-0">
        <!-- Current revision row (always first) -->
        <ul class="list-group list-group-flush" id="revision-list">
          <li class="list-group-item list-group-item-action d-flex align-items-center gap-2 px-3 py-2 active"
              id="rev-row-current"
              style="cursor:pointer;"
              onclick="viewRevision('current', '<%= drawing.revision %>', '<% if (drawing.filePath) { %>/parts/<%= drawing.id %>/download<% } %>', this)">
            <span class="badge bg-primary font-monospace"><%= drawing.revision %></span>
            <div class="flex-grow-1 overflow-hidden">
              <div class="small fw-semibold">Current revision</div>
              <div class="small text-truncate opacity-75"><%= new Date(drawing.updatedAt || drawing.createdAt).toLocaleString() %></div>
            </div>
            <i class="bi bi-eye-fill text-primary flex-shrink-0"></i>
          </li>
          <% if (revisions && revisions.length) { %>
            <% revisions.forEach(function(r) { %>
              <li class="list-group-item list-group-item-action d-flex align-items-center gap-2 px-3 py-2"
                  id="rev-row-<%= r.id %>"
                  style="cursor:pointer;"
                  onclick="viewRevision('<%= r.id %>', '<%= r.revision %>', '<% if (r.filePath) { %>/parts/<%= drawing.id %>/revisions/<%= r.id %>/download<% } %>', this)">
                <span class="badge bg-secondary font-monospace"><%= r.revision %></span>
                <div class="flex-grow-1 overflow-hidden">
                  <div class="small text-muted"><%= new Date(r.createdAt).toLocaleString() %></div>
                  <% if (r.notes) { %>
                    <div class="small text-truncate" title="<%= r.notes %>"><%= r.notes %></div>
                  <% } %>
                  <% if (r.createdBy) { %>
                    <div class="small text-muted"><i class="bi bi-person me-1"></i><%= r.createdBy %></div>
                  <% } %>
                </div>
                <div class="d-flex gap-1 flex-shrink-0 align-items-center">
                  <i class="bi bi-eye-fill text-primary me-1" style="display:none;"></i>
                  <div onclick="event.stopPropagation()">
                    <% if (user && user.isAdmin) { %>
                      <button type="button" class="btn btn-outline-danger btn-sm py-0 px-1"
                              data-url="/parts/<%= drawing.id %>/revisions/<%= r.id %>"
                              data-csrf="<%= csrfToken %>"
                              onclick="removeAssignment(this.dataset.url, this.dataset.csrf, ()=>location.reload())"
                              title="Delete revision record">
                        <i class="bi bi-trash"></i>
                      </button>
                    <% } %>
                  </div>
                </div>
              </li>
            <% }); %>
          <% } %>
        </ul>
        <% if (!revisions || !revisions.length) { %>
          <p class="text-muted small mb-0 p-3">No previous revisions yet.</p>
        <% } %>
      </div>
    </div>

  </div><!-- /sidebar -->

</div>

<!-- Admin: Edit & Delete -->
<% if (user && user.isAdmin) { %>
  <div class="row g-4 mt-0">

    <!-- Bump Revision -->
    <div class="col-12">
      <div class="card shadow-sm border-info">
        <div class="card-header bg-info bg-opacity-10 d-flex align-items-center gap-2">
          <i class="bi bi-arrow-up-circle text-info"></i>
          <strong>Bump to New Revision</strong>
          <span class="ms-2 badge bg-secondary font-monospace"><%= drawing.revision %></span>
          <i class="bi bi-arrow-right mx-1 text-muted"></i>
          <span class="badge bg-info text-dark font-monospace" id="nextRevBadge"></span>
        </div>
        <div class="card-body">
          <p class="text-muted small mb-3">
            The current revision <strong><%= drawing.revision %></strong> will be saved to history and the part will advance to the next revision.
            You can optionally upload a new PDF for the new revision.
          </p>
          <form method="POST" action="/parts/<%= drawing.id %>/revisions?_csrf=<%= encodeURIComponent(csrfToken) %>" enctype="multipart/form-data">
            <div class="row g-2 align-items-end">
              <div class="col-12 col-md-5">
                <label class="form-label small fw-semibold" for="bump-notes">Notes (optional)</label>
                <input type="text" class="form-control form-control-sm" id="bump-notes" name="notes"
                       placeholder="What changed in this revision?" />
              </div>
              <div class="col-12 col-md-5">
                <label class="form-label small fw-semibold" for="bump-pdf">New PDF (optional)</label>
                <input type="file" class="form-control form-control-sm" id="bump-pdf" name="pdf" accept="application/pdf" />
              </div>
              <div class="col-auto">
                <button type="submit" class="btn btn-info btn-sm text-nowrap"
                        onclick="return confirm('Bump revision from <%= drawing.revision %> to next? This cannot be undone.')">
                  <i class="bi bi-arrow-up-circle me-1"></i>Bump Revision
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- Edit Part -->
    <div class="col-12">
      <div class="card shadow-sm border-warning">
        <div class="card-header bg-warning bg-opacity-10 d-flex align-items-center gap-2">
          <i class="bi bi-pencil-square text-warning"></i>
          <strong>Edit Part</strong>
        </div>
        <div class="card-body">
          <form id="editDrawingForm">
            <div class="row g-3">
              <div class="col-12 col-md-4">
                <label class="form-label" for="edit-name">Name</label>
                <input type="text" class="form-control form-control-sm" id="edit-name" name="name" value="<%= drawing.name %>" required />
              </div>
              <div class="col-12 col-md-4">
                <label class="form-label" for="edit-revision">Revision</label>
                <input type="text" class="form-control form-control-sm" id="edit-revision" name="revision" value="<%= drawing.revision || '' %>" />
              </div>
              <div class="col-12 col-md-4">
                <label class="form-label" for="edit-description">Description</label>
                <input type="text" class="form-control form-control-sm" id="edit-description" name="description" value="<%= drawing.description || '' %>" />
              </div>
              <div class="col-12">
                <label class="form-label" for="edit-metadata">Metadata (JSON)</label>
                <textarea class="form-control form-control-sm font-monospace" id="edit-metadata" name="metadata" rows="4"><%= JSON.stringify(drawing.metadata || {}, null, 2) %></textarea>
              </div>
              <div class="col-auto d-flex gap-2">
                <button type="button" class="btn btn-warning btn-sm"
                        id="saveDrawingBtn"
                        data-url="/parts/<%= drawing.id %>"
                        data-csrf="<%= csrfToken %>"
                        onclick="submitEdit(this.dataset.url, 'editDrawingForm', this.dataset.csrf)">
                  <i class="bi bi-save me-1"></i>Save Changes
                </button>
                <button type="button" class="btn btn-danger btn-sm"
                        data-url="/parts/<%= drawing.id %>"
                        data-csrf="<%= csrfToken %>"
                        onclick="deleteEntity(this.dataset.url, this.dataset.csrf, '/parts')">
                  <i class="bi bi-trash me-1"></i>Delete Part
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
<% } %>

<div class="mt-4 small text-muted">
  <i class="bi bi-clock me-1"></i>Last updated: <%= new Date(drawing.updatedAt || drawing.createdAt).toLocaleString() %>
</div>

<script>
(function() {
  // Compute and display the next revision label in the Bump Revision card
  var badge = document.getElementById('nextRevBadge');
  if (badge) {
    var cur = '<%= drawing.revision %>'.toUpperCase();
    badge.textContent = incrementRev(cur);
  }

  function incrementRev(s) {
    var chars = s.split('');
    var i = chars.length - 1;
    while (i >= 0) {
      if (chars[i] < 'Z') { chars[i] = String.fromCharCode(chars[i].charCodeAt(0) + 1); return chars.join(''); }
      chars[i] = 'A'; i--;
    }
    return 'A' + chars.join('');
  }
})();

// Switch the inline PDF viewer to show a specific revision
function viewRevision(revId, revLabel, pdfUrl, rowEl) {
  var iframe      = document.getElementById('pdf-iframe');
  var placeholder = document.getElementById('no-pdf-placeholder');
  var revBadge    = document.getElementById('viewer-rev-badge');
  var dlBtn       = document.getElementById('viewer-download-btn');

  // Highlight active row
  document.querySelectorAll('#revision-list .list-group-item').forEach(function(li) {
    li.classList.remove('active');
    // swap eye icon back to invisible on non-active rows
    var eye = li.querySelector('.bi-eye-fill');
    if (eye) eye.style.display = 'none';
  });
  rowEl.classList.add('active');
  var activeEye = rowEl.querySelector('.bi-eye-fill, .rev-eye');
  if (activeEye) activeEye.style.display = '';

  // Update the badge in the card header
  if (revBadge) revBadge.textContent = revLabel;

  if (!pdfUrl) {
    // No PDF for this revision
    if (iframe)      { iframe.style.display = 'none'; }
    if (placeholder) { placeholder.style.display = ''; }
    if (dlBtn)       { dlBtn.classList.add('d-none'); }
    return;
  }

  if (placeholder) placeholder.style.display = 'none';
  if (dlBtn) {
    dlBtn.href = pdfUrl;
    dlBtn.classList.remove('d-none');
  }

  if (iframe) {
    iframe.style.display = 'block';
    iframe.src = pdfUrl;
  } else {
    // First time — no iframe existed (part had no PDF when page loaded)
    var body = document.getElementById('viewer-body');
    var newIframe = document.createElement('iframe');
    newIframe.id = 'pdf-iframe';
    newIframe.src = pdfUrl;
    newIframe.style.cssText = 'width:100%;height:90vh;min-height:600px;border:none;display:block;';
    body.insertBefore(newIframe, body.firstChild);
  }
}

// Initialise: hide all eye icons except the first (current) one
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('#revision-list .bi-eye-fill').forEach(function(el, i) {
    if (i > 0) el.style.display = 'none';
  });
});
</script>

<%- include('../partials/footer') %>
