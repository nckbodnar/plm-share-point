<%- include('../partials/header', { title, user }) %>

<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
  <div>
    <h1 class="h3 mb-1"><i class="bi bi-people me-2 text-primary"></i>Groups</h1>
    <p class="text-muted mb-0 small">Manage user groups and their project access.</p>
  </div>
  <% if (user && user.isAdmin) { %>
    <a href="/groups/new" class="btn btn-primary btn-sm">
      <i class="bi bi-plus-lg me-1"></i>New Group
    </a>
  <% } %>
</div>

<% if (!groups || groups.length === 0) { %>
  <div class="text-center py-5 text-muted">
    <i class="bi bi-inbox display-3 mb-3 d-block"></i>
    <p class="lead">No groups found.</p>
  </div>
<% } else { %>
  <div class="card shadow-sm">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th>Name</th>
              <th>Members</th>
              <th>Projects</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% groups.forEach(function(group) { %>
              <tr>
                <td>
                  <a href="/groups/<%= group.id %>" class="fw-semibold text-decoration-none">
                    <i class="bi bi-people-fill me-1 text-secondary"></i><%= group.name %>
                  </a>
                </td>
                <td>
                  <span class="badge bg-secondary">
                    <%= group.memberCount !== undefined ? group.memberCount : (group.members ? group.members.length : 0) %>
                  </span>
                </td>
                <td>
                  <span class="badge bg-secondary">
                    <%= group.projectCount !== undefined ? group.projectCount : (group.projects ? group.projects.length : 0) %>
                  </span>
                </td>
                <td>
                  <a href="/groups/<%= group.id %>" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-eye me-1"></i>View
                  </a>
                  <% if (user && user.isAdmin) { %>
                    <form method="POST" action="/groups/<%= group.id %>/delete" class="d-inline">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <button type="submit" class="btn btn-outline-danger btn-sm"
                              onclick="return confirm('Delete group <%= group.name %>?')">
                        <i class="bi bi-trash me-1"></i>Delete
                      </button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <p class="text-muted small mt-3 text-end">
    <i class="bi bi-info-circle me-1"></i>Showing <%= groups.length %> group<%= groups.length !== 1 ? 's' : '' %>.
  </p>
<% } %>

<%- include('../partials/footer') %>
